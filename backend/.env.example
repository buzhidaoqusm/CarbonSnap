JWT_SECRET_KEY=change-me-in-production
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-5.2
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=CarbonSnap
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_OVERPASS_FALLBACK_URLS_JSON=["https://overpass.kumi.systems/api/interpreter","https://overpass.private.coffee/api/interpreter"]
OSM_OVERPASS_TIMEOUT_SECONDS=30
OSM_OVERPASS_CONNECT_TIMEOUT_SECONDS=8
OSM_OVERPASS_MAX_ATTEMPTS_PER_ENDPOINT=2
OSM_OVERPASS_RETRY_BACKOFF_MS=400
OSM_USER_AGENT=CarbonSnap/0.1 (development)
AI_BROWSER_LOCATION_TTL_MINUTES=60
AI_MANUAL_LOCATION_TTL_HOURS=24
AI_MAP_SEARCH_RADIUS_METERS=3000
AI_MAP_SEARCH_LIMIT=12
AI_SHORT_TERM_MEMORY_TURNS=10
FORUM_RAG_EMBEDDING_MODEL=text-embedding-v3
AI_DECISION_ENGINE_VERSION=decision-engine-v2
AI_DECISION_CONFIDENCE_THRESHOLD=0.65
AI_DECISION_ENGINE_MODE=llm_first
AI_TRACE_ENABLED=true
AI_GRAPH_AGENT_ENABLED=false
# Model-driven tool-calling agent loop (native tool calling + LangGraph agent<->tools cycle).
# Requires AI_GRAPH_AGENT_ENABLED=true to take effect on the general-chat route.
AI_TOOL_CALLING_AGENT_ENABLED=false
AI_AGENT_MAX_ITERATIONS=4
AI_LLM_TIMEOUT_SECONDS=60
AI_LLM_MAX_RETRIES=2
# Tool-selection rollout mode: rule (v1, default) | model (v2, model-driven loop) |
# shadow (serve v1 rule reply, compare against what v2 model would select).
# Empty falls back to AI_TOOL_CALLING_AGENT_ENABLED (true -> model).
AI_TOOL_SELECTION_MODE=
# JSONL sink for rule-vs-model tool-selection comparisons (feeds
# scripts/tool_selection_shadow_report.py). Empty disables logging.
AI_TOOL_SELECTION_SHADOW_LOG=
AI_NEO4J_GRAPHRAG_ENABLED=false
AI_PROMPTOPS_SHADOW_ENABLED=false
AI_TRACE_INCLUDE_RETRIEVAL_EXCERPTS=true
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
UPLOAD_ROOT=
UPLOAD_URL_PREFIX=/api/uploads
